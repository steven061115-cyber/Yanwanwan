    "购买失败：请确认网络和 App Store 账户状态后重试" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchase failed. Check your connection and App Store account, then try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入に失敗しました。接続とApp Storeアカウントを確認して、もう一度お試しください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매에 실패했습니다. 연결과 App Store 계정을 확인한 뒤 다시 시도해 주세요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
