    "7 天内没有快结束的活动，婉婉先盯着。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing ends within 7 days. Wanwan's keeping watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天内没有快结束的活动，婉婉先盯着。"
