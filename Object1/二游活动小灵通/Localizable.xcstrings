          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ isn't done yet and has %@ left. Finish it, then bed!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の「%@」がまだ終わっていません。残り%@、終わったら寝てね！"
