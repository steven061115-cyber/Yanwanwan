          }
        }
      }
    },
    "以上内容由 %@ 整理，仅供参考。请对照游戏官方公告核对名称和日期后再保存。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organized by %@ for reference only. Check names and dates against the official notice before saving."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が整理した参考情報です。保存する前に公式のお知らせと名前・日付を照らし合わせてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@가 정리한 참고용 정보입니다. 저장하기 전에 공식 공지와 이름·날짜를 대조해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以上内容由 %@ 整理，仅供参考。请对照游戏官方公告核对名称和日期后再保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以上內容由 %@ 整理，僅供參考。請對照遊戲官方公告核對名稱和日期後再保存。"
          }
        }
      }
    },
    "以上内容由 %@ 整理，仅供参考。请对照游戏官方公告核对后再保存；保存后会用勾选内容替换原活动并重建提醒。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organized by %@ for reference only. Check against the official notice before saving. Saving replaces the current events with the ones you checked and resets reminders."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が整理した参考情報です。保存する前に公式のお知らせと照らし合わせてください。保存すると、チェックしたイベントで今のイベントを置き換え、リマインダーを作り直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@가 정리한 참고용 정보입니다. 저장하기 전에 공식 공지와 대조해 주세요. 저장하면 선택한 이벤트로 기존 이벤트를 바꾸고 알림을 다시 만듭니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以上内容由 %@ 整理，仅供参考。请对照游戏官方公告核对后再保存；保存后会用勾选内容替换原活动并重建提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以上內容由 %@ 整理，僅供參考。請對照遊戲官方公告核對後再保存；保存後會用勾選內容替換原活動並重建提醒。"
          }
        }
      }
    },
    "会删除当前安装标识对应的服务器额度记录，并生成新的安装标识。" : {
      "localizations" : {
        "en" : {
