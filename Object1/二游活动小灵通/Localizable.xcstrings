          }
        }
      }
    },
    "会删除当前安装标识对应的服务器额度记录，并生成新的安装标识。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the server quota records for your current install ID and creates a new one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会删除当前安装标识对应的服务器额度记录，并生成新的安装标识。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會刪除當前安裝識別碼對應的伺服器額度記錄，並生成新的安裝識別碼。"
          }
        }
      }
    },
    "会删除设备内的游戏、活动、缓存、设置和通知。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the games, events, cache, settings and notifications on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会删除设备内的游戏、活动、缓存、设置和通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會刪除裝置內的遊戲、活動、快取、設定和通知。"
          }
        }
      }
    },
    "会同时删除设备数据和当前安装标识对应的服务器记录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes both your device data and the server records for your current install ID."
